# Secrets — never commit
.env
.env.local
.env.*.local
secrets/
secrets/*.txt
docs/plugins/examples/*.zip
# Built plugin packages and fetched (not committed) model weights
plugins/*.zip
plugins/semantic-segmentation/models/*.onnx
plugins/semantic-segmentation/models/*.pth
!plugins/semantic-segmentation/models/landcover-segformer-b0.onnx
# Detector weights are never committed (large; the YOLO exports are AGPL) — tools/fetch_models.py
plugins/object-detection/models/*.onnx
plugins/object-detection/models/*.part
# Docker compose override for local dev
docker-compose.override.yml

# Migration artifacts
migration/

# OS / editor cruft
.DS_Store
*.swp
*.bak
.idea/
.vscode/

# Runtime / generated artifacts
*.rdb
*.sess
logs/
frappe-bench/config/
frappe-bench/patches.txt
frappe-bench/sites/apps.json
frappe-bench/sites/common_site_config.json
frappe-bench/sites/*/
__pycache__/
*.pyc
.pytest_cache/

# Local agent / tooling caches
.opencode/
.claude/
.superpowers/
.backups/
.playwright-mcp/
