{{- /*
  Kubernetes edition of infra/caddy/Caddyfile, rendered into a ConfigMap.
  The site blocks are kept line-for-line with the compose file (whitelist,
  SocketIO host fix-ups, security headers, CSP, rate limits); when one changes,
  change the other. Only the Kubernetes-specific parts are templated: TLS
  mode, PROXY protocol / trusted proxies, and the probe listener.
*/ -}}
{{- $tls := .Values.caddy.tls -}}
{{- $scheme := ternary "http://" "" (eq $tls.mode "off") -}}
{{- $trusted := gt (len .Values.caddy.trustedProxies) 0 -}}
{{- /* With trusted proxies the client is taken from X-Forwarded-For. */ -}}
{{- $ipMatcher := ternary "client_ip" "remote_ip" $trusted -}}
{{- $clientIP := ternary "{client_ip}" "{remote}" $trusted -}}
{{- $rateKey := ternary "{client_ip}" "{remote_host}" $trusted -}}
{{- /* Behind an Ingress the browser speaks HTTPS even though Caddy sees HTTP. */ -}}
{{- $proto := ternary "https" "{scheme}" .Values.caddy.ingress.enabled -}}
{
    email {{ $tls.email | default (printf "admin@%s" .Values.site.domain) }}
    admin off
{{- if eq $tls.mode "off" }}
    auto_https off
{{- end }}
{{- if or .Values.caddy.proxyProtocol.enabled $trusted }}
{{- range $listener := ternary (list ":80") (list ":80" ":443") (eq $tls.mode "off") }}
    servers {{ $listener }} {
{{- if $.Values.caddy.proxyProtocol.enabled }}
        listener_wrappers {
            proxy_protocol {
                timeout 5s
                allow {{ join " " $.Values.caddy.proxyProtocol.allow }}
            }
{{- if eq $listener ":443" }}
            tls
{{- end }}
        }
{{- end }}
{{- if $trusted }}
        trusted_proxies static {{ join " " $.Values.caddy.trustedProxies }}
{{- end }}
    }
{{- end }}
{{- end }}
}

# Probe target for the kubelet; not published by the Service.
http://:8081 {
    respond /healthz "ok" 200
}

# Admin subdomain — Frappe Desk UI. Root redirects to /desk.
{{ $scheme }}admin.{$SITE_DOMAIN} {
{{- template "webodm.caddy.tls" $tls }}
    encode zstd gzip

    # The Desk/admin surface is not public: only client IPs in ADMIN_WHITELIST
    # may reach it. Defaults to private ranges so an unset value fails closed.
    @not_admin_ip not {{ $ipMatcher }} {$ADMIN_WHITELIST:private_ranges}

    handle @not_admin_ip {
        respond "Forbidden" 403
    }

    handle {
        # Unauthenticated login endpoint: same rate limit as the main vhost,
        # in its own zone.
        @login path /api/method/login
        rate_limit @login {
            zone login_admin {
                match {
                    path /api/method/login
                }
                key {{ $rateKey }}
                window 1s
                events 50
            }
        }

        @root path /
        redir @root /desk permanent

        header {
            Strict-Transport-Security "max-age=31536000; includeSubDomains"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            Referrer-Policy "strict-origin-when-cross-origin"
            Permissions-Policy "geolocation=(), microphone=(), camera=()"
            Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; connect-src 'self' wss://admin.{$SITE_DOMAIN} blob:; worker-src 'self' blob:; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'none'"
            -Server
        }

        # SocketIO long-lived connections.
        @socketio path /socket.io/*
        reverse_proxy @socketio frappe-socketio:9000 {
            header_up Host {host}
            header_up X-Frappe-Site-Name {$SITE_DOMAIN}
        }

        # Frappe static files (assets, files, public, private).
        @assets path /assets/** /files/** /public/** /private/files/**
        reverse_proxy @assets frappe-web:8000 {
            header_up Host {$SITE_DOMAIN}
        }

        # Everything else → Frappe web.
        reverse_proxy frappe-web:8000 {
            header_up Host {$SITE_DOMAIN}
            header_up X-Real-IP {{ $clientIP }}
            header_up X-Forwarded-For {{ $clientIP }}
            header_up X-Forwarded-Proto {{ $proto }}
        }
    }
}

{{ $scheme }}{$SITE_DOMAIN} {
{{- template "webodm.caddy.tls" $tls }}
    encode zstd gzip

    # WebODM SPA is the home page. Redirect the root to the SPA base so the
    # site root opens the Vue app directly (Frappe desk stays at /desk).
    @root path /
    redir @root /assets/webodm_frontend/frontend/ permanent

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; connect-src 'self' wss://{$SITE_DOMAIN} blob:; worker-src 'self' blob:; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'none'"
        -Server
    }

    # Rate limit Frappe login endpoint.
    @login path /api/method/login
    rate_limit @login {
        zone login {
            match {
                path /api/method/login
            }
            key {{ $rateKey }}
            window 1s
            events 50
        }
    }

    # Allow large file uploads (drone images can be 50MB+ each).
    @upload path /api/method/*
    request_body @upload {
        max_size 10GB
    }

    # SocketIO long-lived connections.
    @socketio path /socket.io/*
    reverse_proxy @socketio frappe-socketio:9000 {
        header_up Host {host}
    }

    # NOTE: the geospatial service is intentionally NOT exposed here. It has no
    # authentication of its own and must only be reached via the session-authed
    # Frappe proxy (webodm_core.api.tiles).

    # Frappe static files (assets, files, public, private).
    # Use ** to match nested paths (e.g. /assets/frappe/dist/css/login.bundle.css).
    @assets path /assets/** /files/** /public/** /private/files/**
    reverse_proxy @assets frappe-web:8000

    # Everything else → Frappe web (Vue SPA fallback included).
    reverse_proxy frappe-web:8000 {
        header_up Host {host}
        header_up X-Real-IP {{ $clientIP }}
        header_up X-Forwarded-For {{ $clientIP }}
        header_up X-Forwarded-Proto {{ $proto }}
    }
}
