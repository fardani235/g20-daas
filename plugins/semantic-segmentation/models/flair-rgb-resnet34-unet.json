    "paper": "Garioud et al., FLAIR: a Country-Scale Land Cover Semantic Segmentation Dataset From Multi-Source Optical Imagery, NeurIPS 2023, arXiv:2310.13336",
    "export": "tools/export_flair_unet.py (graph takes [0,1] RGB, applies the card's 0-255 mean/std normalisation internally, returns softmax probabilities over the 19-class head)"
  }
