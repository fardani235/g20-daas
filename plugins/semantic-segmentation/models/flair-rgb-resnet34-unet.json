{
  "id": "flair-rgb-resnet34-unet",
  "label": "Land cover — FLAIR U-Net/ResNet-34 (aerial RGB, optional height fusion)",
  "description": "IGN's FLAIR land-cover model: a U-Net with ResNet-34 encoder trained on 0.2 m RGB aerial orthophotos of France (19-class nomenclature, 15 evaluated). The closest published match to drone orthophotos. When a DSM (and DTM) are also selected, height above ground refines elevated vs. ground classes by Bayesian late fusion.",
  "backend": "onnx",
  "auto_priority": 40,
  "inputs": { "required": ["orthophoto"], "optional": ["dsm", "dtm"] },
  "onnx": {
    "file": "flair-rgb-resnet34-unet.onnx",
    "sha256": "2a9bb653edeb416bc0de9eec9690bb32811223169c33c6a0025c0da441baed19",
    "input": "pixel_values",
    "output": "probabilities",
    "output_type": "probabilities",
    "channels": ["red", "green", "blue"],
    "scale": "unit",
    "mean": null,
    "std": null,
    "input_size": 512
  },
  "classes": [
    { "id": 0,  "name": "building",              "color": "#db0e9a" },
    { "id": 1,  "name": "pervious_surface",      "color": "#938e7b" },
    { "id": 2,  "name": "impervious_surface",    "color": "#f80c00" },
    { "id": 3,  "name": "bare_soil",             "color": "#a97101" },
    { "id": 4,  "name": "water",                 "color": "#1553ae" },
    { "id": 5,  "name": "coniferous",            "color": "#194a26" },
    { "id": 6,  "name": "deciduous",             "color": "#46e483" },
    { "id": 7,  "name": "brushwood",             "color": "#f3a60d" },
    { "id": 8,  "name": "vineyard",              "color": "#660082" },
    { "id": 9,  "name": "herbaceous_vegetation", "color": "#55ff00" },
    { "id": 10, "name": "agricultural_land",     "color": "#fff30d" },
    { "id": 11, "name": "plowed_land",           "color": "#e4df7c" },
    { "id": 12, "name": "swimming_pool",         "color": "#3de6eb" },
    { "id": 13, "name": "snow",                  "color": "#ffffff" },
    { "id": 14, "name": "clear_cut",             "color": "#8ab3a0" },
    { "id": 15, "name": "mixed",                 "color": "#6b714f" },
    { "id": 16, "name": "ligneous",              "color": "#c5dc42" },
    { "id": 17, "name": "greenhouse",            "color": "#9999ff" },
    { "id": 18, "name": "other",                 "color": "#000000" }
  ],
  "height_fusion": {
    "elevated_threshold_m": 2.0,
    "softness_m": 0.75,
    "classes": {
      "building": "elevated",
      "pervious_surface": "ground",
      "impervious_surface": "ground",
      "bare_soil": "ground",
      "water": "ground",
      "coniferous": "elevated",
      "deciduous": "elevated",
      "brushwood": "any",
      "vineyard": "ground",
      "herbaceous_vegetation": "ground",
      "agricultural_land": "ground",
      "plowed_land": "ground",
      "swimming_pool": "ground",
      "snow": "any",
      "clear_cut": "ground",
      "mixed": "any",
      "ligneous": "any",
      "greenhouse": "any",
      "other": "any"
    }
  },
  "recommended": { "resolution_m": 0.2, "tile_size": 512, "overlap": 64 },
  "source": {
    "name": "IGNF/FLAIR-INC_rgb_15cl_resnet34-unet",
    "url": "https://huggingface.co/IGNF/FLAIR-INC_rgb_15cl_resnet34-unet",
