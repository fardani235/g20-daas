   "fieldtype": "Section Break",
   "label": "Cameras"
  },
  {
   "fieldname": "cameras",
   "fieldtype": "Small Text",
   "label": "Cameras",
   "description": "Comma-separated camera profile ids this aircraft can carry (built-in ids such as dji-zenmuse-p1-35mm, or custom:<name>). * = any camera."
  },
  {
   "fieldname": "default_camera",
   "fieldtype": "Data",
   "label": "Default Camera"
  },
  {
   "fieldname": "mission_section",
   "fieldtype": "Section Break",
   "label": "Mission capability",
   "description": "What the aircraft's flight app can be given. Do not tick or list a capability the aircraft does not have: exports are offered on the strength of this."
  },
  {
   "fieldname": "ecosystem",
   "fieldtype": "Data",
   "label": "Flight App Family",
   "description": "How missions reach this aircraft (dji-enterprise, dji-fly, mavlink, litchi, vendor, manual). Set from the planner; it pre-fills the capability fields below."
