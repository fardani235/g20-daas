  },
  {
   "fieldname": "manufacturer",
   "fieldtype": "Data",
   "label": "Manufacturer",
   "in_list_view": 1
  },
  {
   "fieldname": "airframe",
   "fieldtype": "Select",
   "label": "Airframe",
   "options": "multirotor\nfixed-wing\nvtol",
   "default": "multirotor",
   "in_list_view": 1,
   "description": "A fixed-wing or VTOL cannot stop at a waypoint: lines are extended by the turn radius."
  },
  {
   "fieldname": "rtk",
   "fieldtype": "Select",
   "label": "RTK",
   "options": "none\noptional\nstandard",
   "default": "none"
  },
  {
   "fieldname": "endurance_section",
   "fieldtype": "Section Break",
   "label": "Endurance"
  },
  {
   "fieldname": "max_flight_time_min",
   "fieldtype": "Float",
   "label": "Rated Flight Time (min)",
   "reqd": 1,
   "in_list_view": 1,
   "description": "The manufacturer's figure, or better, your own measurement."
  },
  {
   "fieldname": "endurance_factor",
   "fieldtype": "Float",
   "label": "Endurance Factor",
   "default": "0.8",
   "description": "Share of the rated time you actually get with your payload and conditions (0.1-1). Usable time per battery = rated time x this factor x (1 - reserve)."
  },
  {
   "fieldname": "endurance_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "takeoff_mass_g",
   "fieldtype": "Float",
   "label": "Takeoff Mass (g)",
   "description": "0 = unknown."
  },
  {
   "fieldname": "max_wind_ms",
   "fieldtype": "Float",
   "label": "Wind Limit (m/s)",
   "description": "Shown as context only; wind is not modelled. 0 = unknown."
  },
  {
   "fieldname": "performance_section",
   "fieldtype": "Section Break",
   "label": "Performance",
   "description": "0 means unknown for every optional figure here; the planner then skips the check that needs it rather than guessing."
  },
  {
   "fieldname": "max_speed_ms",
   "fieldtype": "Float",
   "label": "Top Speed (m/s)",
   "reqd": 1
  },
  {
   "fieldname": "max_mission_speed_ms",
   "fieldtype": "Float",
   "label": "Automated Flight Speed Limit (m/s)",
   "description": "Speed limit of waypoint flight, if lower than the top speed."
  },
  {
   "fieldname": "cruise_speed_ms",
   "fieldtype": "Float",
   "label": "Suggested Mapping Speed (m/s)",
   "description": "Default flight speed for new plans."
  },
  {
   "fieldname": "min_speed_ms",
   "fieldtype": "Float",
   "label": "Minimum Airspeed (m/s)",
   "description": "Fixed-wing and VTOL only."
  },
  {
   "fieldname": "performance_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "max_ascent_ms",
