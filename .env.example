# --- Site identity ---
SITE_DOMAIN=webodm.local
SITE_NAME=webodm.local

# Client IPs/CIDRs (space-separated) allowed to reach admin.$SITE_DOMAIN (Frappe
# Desk). Unset defaults to private ranges, so an internet client gets 403 until
# you list your own addresses, e.g. "203.0.113.4 198.51.100.0/24".
ADMIN_WHITELIST=

# --- Database (non-secret handles only — password via Docker secret) ---
DB_NAME=webodm
DB_USER=webodm

# --- Caddy TLS (set ONE provider) ---
# Cloudflare:
CLOUDFLARE_API_TOKEN=
# Route53 (set both):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Backup ---
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_ENDPOINT=

# --- Object storage (canonical store for task inputs/outputs) ---------------
# Leave WEBODM_S3_BUCKET empty to keep host disk as the only store. With a
# bucket set, S3 is canonical and private/files becomes a serving cache.
# Credentials go in secrets/s3_app_*.txt and secrets/s3_geospatial_*.txt
# (see docs/on-demand-processing/deployment.md), never here.
WEBODM_S3_BUCKET=
# Optional key prefix inside the bucket (e.g. "prod/"; must end with "/").
WEBODM_S3_PREFIX=
WEBODM_S3_REGION=eu-central-1
# Empty for AWS S3. For MinIO / other S3-compatible: http://minio:9000
WEBODM_S3_ENDPOINT_URL=
# 1 for MinIO-style path addressing; 0 for AWS.
WEBODM_S3_FORCE_PATH_STYLE=0
# Serving-cache budget (bytes) and idle eviction age (seconds).
WEBODM_CACHE_MAX_BYTES=53687091200
WEBODM_CACHE_IDLE_SECONDS=604800

# --- On-demand compute ------------------------------------------------------
# Empty PROVISIONER_URL = no provider: tasks run on the static `nodeodm`
# service. Set to http://provisioner:5002 to provision a node per task.
PROVISIONER_URL=
# none | aws | fixed (dev only: hands back the stack's own nodeodm container)
PROVISIONER_PROVIDER=none
WEBODM_COMPUTE_MAX_INSTANCES=5
WEBODM_COMPUTE_MAX_INSTANCES_PER_ORG=2
WEBODM_COMPUTE_PROVISION_TIMEOUT_SECONDS=900
WEBODM_COMPUTE_MAX_LIFETIME_SECONDS=43200
PROVISIONER_NODEODM_IMAGE=opendronemap/nodeodm:latest
# Extra NodeODM flags baked into the node, e.g. "--max_concurrency 8"
PROVISIONER_NODEODM_ARGS=

# AWS provider (PROVISIONER_PROVIDER=aws). Every value is required; there are
# no usable defaults. Credentials: secrets/aws_provisioner_*.txt.
PROVISIONER_AWS_REGION=eu-central-1
# Prebaked AMI from infra/aws/bake-nodeodm-ami.sh, or a stock Ubuntu 24.04 AMI
# (the bootstrap then installs Docker + pulls NodeODM on first boot).
PROVISIONER_AWS_AMI_ID=ami-0123456789abcdef0
PROVISIONER_AWS_AMI_PREBAKED=false
# instance class -> EC2 type. "cpu" is the default class; "cpu-large" is
# picked for ultra-quality options or very large image sets.
PROVISIONER_AWS_INSTANCE_TYPES={"cpu": "c6i.2xlarge", "cpu-large": "c6i.8xlarge"}
# USD/hour per class, for the stored cost *estimate* only.
PROVISIONER_AWS_HOURLY_COSTS={"cpu": 0.34, "cpu-large": 1.36}
PROVISIONER_AWS_DEFAULT_CLASS=cpu
# Public subnet with a route to the internet (NodeODM must be reachable).
PROVISIONER_AWS_SUBNET_ID=subnet-0123456789abcdef0
# Security group allowing TCP 3000 from this host's egress IP only.
PROVISIONER_AWS_SECURITY_GROUP_IDS=sg-0123456789abcdef0
PROVISIONER_AWS_ROOT_VOLUME_GB=200
# Optional: SSH key pair for debugging a node, IAM instance profile for the node.
PROVISIONER_AWS_KEY_NAME=
PROVISIONER_AWS_IAM_INSTANCE_PROFILE=
