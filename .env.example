# --- Site identity ---
SITE_DOMAIN=webodm.local
SITE_NAME=webodm.local
# Image versions/digests are fixed in docker-compose.yml (scripts/pin-images.sh),
# not configured here. Frappe version follows the `frappe` submodule pin.

# --- Database (non-secret handles only — password via Docker secret) ---
DB_NAME=webodm
DB_USER=webodm

# --- Caddy TLS (set ONE provider) ---
# Cloudflare:
CLOUDFLARE_API_TOKEN=
# Route53 (set both):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Backup ---
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_ENDPOINT=
